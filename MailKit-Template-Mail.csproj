<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>MailKit_Template_Mail</RootNamespace>
    <AssemblyName>MailKit-Template-Mail</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <!-- Fail restore when a package with a known vulnerability is referenced -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MailKit >= 4.16.0 fixes GHSA-9j88-vvj5-vhgr (STARTTLS response injection) -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit >= 4.15.1 fixes GHSA-g7hc-96xr-gvvx (CRLF injection) and GHSA-gmc6-fwg3-75m5 -->
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- BouncyCastle >= 2.3.1 fixes GHSA-v435-xc8x-wvr9, GHSA-m44j-cfrm-g8qc, GHSA-8xfc-gm6g-vgpv -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- System.Formats.Asn1 >= 8.0.1 fixes CVE-2024-38095 -->
    <PackageReference Include="System.Formats.Asn1" Version="10.0.12" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Content Include="SendOtpToEmail.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
